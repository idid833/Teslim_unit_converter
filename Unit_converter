
# ENGINEERING UNIT CONVERTER
# ND1 Mechatronics Engineering Project

# Function to convert units
def convert_units():
    print("\n===== ENGINEERING UNIT CONVERTER =====")
    print("1. Millimetres to Inches")
    print("2. Inches to Millimetres")
    print("3. Celsius to Fahrenheit")
    print("4. Fahrenheit to Celsius")
    print("5. Kilograms to Pounds")
    print("6. Pounds to Kilograms")
    print("7. Km/h to m/s")
    print("8. m/s to Km/h")
    print("9. View Conversion History")
    print("0. Exit")

# Store previous conversions
history = []

# Main program loop
while True:
    convert_units()

    choice = input("\nChoose a conversion (0-9): ")

    if choice == "0":
        print("Thank you for using Engineering Unit Converter!")
        break

    elif choice == "9":
        if history:
            print("\n--- CONVERSION HISTORY ---")
            for item in history:
                print(item)
        else:
            print("No conversion history yet.")

    elif choice in ["1", "2", "3", "4", "5", "6", "7", "8"]:

        try:
            value = float(input("Enter the value to convert: "))

            if choice == "1":
                result = value / 25.4
                answer = f"{value} mm = {result:.4f} inches"

            elif choice == "2":
                result = value * 25.4
                answer = f"{value} inches = {result:.4f} mm"

            elif choice == "3":
                result = (value * 9/5) + 32
                answer = f"{value} °C = {result:.2f} °F"

            elif choice == "4":
                result = (value - 32) * 5/9
                answer = f"{value} °F = {result:.2f} °C"

            elif choice == "5":
                result = value * 2.20462
                answer = f"{value} kg = {result:.4f} lb"

            elif choice == "6":
                result = value / 2.20462
                answer = f"{value} lb = {result:.4f} kg"

            elif choice == "7":
                result = value / 3.6
                answer = f"{value} km/h = {result:.4f} m/s"

            elif choice == "8":
                result = value * 3.6
                answer = f"{value} m/s = {result:.4f} km/h"

            print("\nConversion Result:")
            print(answer)

            # Save conversion in history
            history.append(answer)

        except ValueError:
            print("Invalid input! Please enter a valid number.")

    else:
        print("Invalid choice! Please select between 0 and 9.")
